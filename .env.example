# MENU SCAN frontend environment.

# Backend API origin, used by the server only (server-side data fetching and
# the `/api/v1/*` rewrite that proxies API calls through the Next origin).
# Defaults to `http://localhost:4000` (the local Express backend) when unset.
# In production set this to the deployed backend, e.g.
# BACKEND_API_URL=https://menuscan-api.onrender.com
BACKEND_API_URL=http://localhost:4000